# Este arquivo serve como referência para configuração no painel da Vercel (Project Settings > Environment Variables).
# NUNCA insira credenciais reais neste arquivo.

# --- SUPABASE INTEGRATION (SERVER-ONLY) ---
# Segredo dedicado exclusivo para ingestão de leads (menor privilégio, sem acesso direto ao banco).
# Deve coincidir com o valor configurado em Supabase Secrets: LEAD_INGEST_SECRET
LEAD_INGEST_SECRET=

# URL base do projeto Supabase
SUPABASE_URL=https://jsmxdavhddvwuspzqtkn.supabase.co

# Endpoint da Edge Function de ingestão de leads
SUPABASE_EDGE_FUNCTION_URL=https://jsmxdavhddvwuspzqtkn.supabase.co/functions/v1/receber-lead

# --- BUILD & RUNTIME CONFIGURATION ---
# Opcional: define o preset do Nitro.
# - Na Vercel: detectado automaticamente quando VERCEL=1 (preset: vercel)
# - Na Guará Cloud (Docker/Node.js): definido no Dockerfile como NITRO_PRESET=node-server

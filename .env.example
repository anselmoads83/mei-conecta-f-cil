# Environment Variables Template
# PROJETO: Anselmo Dias Contador (mei-conecta-f-cil)
# Este arquivo serve como referência para configuração no painel da Guará Cloud.
# NUNCA insira credenciais reais neste arquivo.

# --- BREVO TRANSACTIONAL API (SERVER-ONLY) ---
# Chave de API transacional gerada no painel da Brevo (v3 API Keys).
# Acesso estritamente restrito ao servidor Node.js/Nitro SSR.
BREVO_API_KEY=

# Remetente autenticado oficial (validado no domínio anselmodiascontador.com.br)
BREVO_SENDER_NAME="Anselmo Dias Contador"
BREVO_SENDER_EMAIL=gestao@anselmodiascontador.com.br

# Destinatário interno para recebimento das notificações de leads
BREVO_NOTIFICATION_EMAIL=gestao@anselmodiascontador.com.br

# Identificadores numéricos dos 4 Templates Transacionais cadastrados no painel da Brevo
# Template 1: MEI 360° Notificação Interna
BREVO_TEMPLATE_MEI360_INTERNAL=
# Template 2: MEI 360° Confirmação ao Visitante
BREVO_TEMPLATE_MEI360_CONFIRMATION=
# Template 3: Fale Conosco Notificação Interna
BREVO_TEMPLATE_CONTACT_INTERNAL=
# Template 4: Fale Conosco Confirmação ao Visitante
BREVO_TEMPLATE_CONTACT_CONFIRMATION=

# Origens permitidas para requisições cross-origin (separadas por vírgula)
ALLOWED_ORIGINS=https://www.anselmodiascontador.com.br,https://anselmodiascontador.com.br

# --- BUILD & RUNTIME CONFIGURATION ---
# Na Guará Cloud (Docker/Node.js): definido no Dockerfile como NITRO_PRESET=node-server
# NITRO_PRESET=node-server
# PORT=3000
# HOST=0.0.0.0
